--label:装飾

--select@zabuton_type:ざぶとんタイプ=0,行ごと=0,全体=1

--group:サイズ,true
--track@sx:Xサイズ,-1000,1000,170,1
--track@sy:Yサイズ,-1000,1000,70,1
--group

--group:個別1~10サイズ,false
--track@sx1:Xサイズ1,-1000,1000,0,1
--track@sy1:Yサイズ1,-1000,1000,0,1
--track@sx2:Xサイズ2,-1000,1000,0,1
--track@sy2:Yサイズ2,-1000,1000,0,1
--track@sx3:Xサイズ3,-1000,1000,0,1
--track@sy3:Yサイズ3,-1000,1000,0,1
--track@sx4:Xサイズ4,-1000,1000,0,1
--track@sy4:Yサイズ4,-1000,1000,0,1
--track@sx5:Xサイズ5,-1000,1000,0,1
--track@sy5:Yサイズ5,-1000,1000,0,1
--track@sx6:Xサイズ6,-1000,1000,0,1
--track@sy6:Yサイズ6,-1000,1000,0,1
--track@sx7:Xサイズ7,-1000,1000,0,1
--track@sy7:Yサイズ7,-1000,1000,0,1
--track@sx8:Xサイズ8,-1000,1000,0,1
--track@sy8:Yサイズ8,-1000,1000,0,1
--track@sx9:Xサイズ9,-1000,1000,0,1
--track@sy9:Yサイズ9,-1000,1000,0,1
--track@sx10:Xサイズ10,-1000,1000,0,1
--track@sy10:Yサイズ10,-1000,1000,0,1
--group

--group:位置,true
--track@px:X位置,-1000,1000,0,1
--track@py:Y位置,-1000,1000,0,1
--group

--group:個別1~10位置,false
--track@px1:X位置1,-1000,1000,0,1
--track@py1:Y位置1,-1000,1000,0,1
--track@px2:X位置2,-1000,1000,0,1
--track@py2:Y位置2,-1000,1000,0,1
--track@px3:X位置3,-1000,1000,0,1
--track@py3:Y位置3,-1000,1000,0,1
--track@px4:X位置4,-1000,1000,0,1
--track@py4:Y位置4,-1000,1000,0,1
--track@px5:X位置5,-1000,1000,0,1
--track@py5:Y位置5,-1000,1000,0,1
--track@px6:X位置6,-1000,1000,0,1
--track@py6:Y位置6,-1000,1000,0,1
--track@px7:X位置7,-1000,1000,0,1
--track@py7:Y位置7,-1000,1000,0,1
--track@px8:X位置8,-1000,1000,0,1
--track@py8:Y位置8,-1000,1000,0,1
--track@px9:X位置9,-1000,1000,0,1
--track@py9:Y位置9,-1000,1000,0,1
--track@px10:X位置10,-1000,1000,0,1
--track@py10:Y位置10,-1000,1000,0,1
--group

--group:その他,true
--track@alpha:透明度,0,100,100,1
--group

--group:図形,true
--select@shapes:図形=1,背景=0,四角形=1,円=2,三角形=3
--color@shape_col:図形色,0x960a0a
--group

--group:装飾,true
--track@frame_size:縁取り,0,100,0,1
--color@frame_col:縁色,0xffffff
--group

local Akira = require("AKIRA_aviutl2_helper")

obj.copybuffer("cache:org","object")

-- 文字ごとに個別オブジェクトがONだったとき用に、座標を復元するように作成した変数
local ox,oy,oz,cx,cy,cz = obj.ox,obj.oy,obj.oz,obj.cx,obj.cy,obj.cz
local w,h = obj.w,obj.h

-- 文字ごとに個別オブジェクトか否かを判定する用の変数
local is_multi = obj.getoption("multi_object")

-- 仮想画面の作成
Akira.create_screen_tempbuffer()

-- トラックバーおよび選択肢の値の取得
local shape_names = {[1] = "四角形", [2] = "円", [3] = "三角形"}
local shape_name = shape_names[shapes] or "四角形"

-- 行数の確認（ヘッダーヘルパー利用）
local lb = Akira.line_break_confirmation()
if lb < 1 then lb = 1 end

local size = obj.getvalue("テキスト","サイズ")

local t_cs = obj.getvalue("テキスト","字間")
local t_ls = obj.getvalue("テキスト","行間")

-- 各行のサイズ一覧を配列テーブルとして取得する関数
-- sizes[1][1],seizes[1][2]のようになっている。
-- 配列名:sizes, 配列要素[1][1] = w,配列要素[1][2] = h
local sizes = Akira.get_line_sizes()

-- 最後の行のwのサイズ
local last_line_w = sizes[#sizes][1]

-- 各行の内容を配列テーブルとして返す関数
-- lines[1]のようになっている。
-- 配列名:lines, 配列要素[1] = 1行目の内容 となっている。
local lines = Akira.get_lines_from_text()

local align = obj.getvalue("テキスト","文字揃え")

-- 数値に変換
local align_type_number = {
    ["左寄せ[上]"] = 0,
    ["中央揃え[上]"] = 1,
    ["右寄せ[上]"] = 2,
    ["左寄せ[中]"] = 3,
    ["中央揃え[中]"] = 4,
    ["右寄せ[中]"] = 5,
    ["左寄せ[下]"] = 6,
    ["中央揃え[下]"] = 7,
    ["右寄せ[下]"] = 8,
    ["縦書 上寄[右]"] = 9,
    ["縦書 中央[右]"] = 10,
    ["縦書 下寄[右]"] = 11,
    ["縦書 上寄[中]"] = 12,
    ["縦書 中央[中]"] = 13,
    ["縦書 下寄[中]"] = 14,
    ["縦書 上寄[左]"] = 15,
    ["縦書 中央[左]"] = 16,
    ["縦書 下寄[左]"] = 17,
}

local align_num = align_type_number[align] or 4 -- nilまたは未定義文字列の場合は 4 (中央揃え[中]) を採用

-- 最大幅の取得
local max_width = 0
for i = 1, #sizes do
    max_width = math.max(max_width, sizes[i][1])
end

-- 行ごとのX座標オフセットを格納するテーブル
local offset_x = {}

for i = 1, #sizes do
    local w_i = sizes[i][1]
    if w_i == max_width then
        -- 最大幅の行はオフセット0
        offset_x[i] = 0
    else
        -- align_num に応じた座標ズレの補正
        if align_num == 0 or align_num == 3 or align_num == 6 then
            -- 左寄せ: 最大幅の左端に合わせる
            offset_x[i] = -(max_width - w_i) * 1.5 * (size / 100)
        elseif align_num == 2 or align_num == 5 or align_num == 8 then
            -- 右寄せ: 最大幅の右端に合わせる
            offset_x[i] = (max_width - w_i) * 1.5 * (size / 100)
        else
            -- 中央揃え (1, 4, 7) およびその他
            offset_x[i] = 0
        end
    end
end

-- Y座標オフセットを格納するテーブル
local offset_y = {}

for i = 1, #sizes do
    local h_i = sizes[i][1]
    -- オフセット初期値は0
    offset_y[i] = 0
    -- align_num に応じた座標ズレの補正
    if align_num <= 2 then
        -- [上]
        offset_y[i] = -(offset_y[i] - ((h / 2) / lb))
    elseif align_num <= 5 then
        -- 「中央」
        offset_y[i] = 0
    else
        -- 「下」
        offset_y[i] = offset_y[i] - ((h / 2) / lb)
    end
end

if zabuton_type == 0 then -- 行ごと
    for i = 1,#sizes do
    obj.load("figure",shape_name,shape_col,100)
        -- sxN, syN をテーブルとしてまとめる（スクリプト初期化部分などで定義）
        local sxs = { sx1, sx2, sx3, sx4, sx5, sx6, sx7, sx8, sx9, sx10 }
        local sys = { sy1, sy2, sy3, sy4, sy5, sy6, sy7, sy8, sy9, sy10 }

        -- ここはxを*3する変数。*3したらぴったりサイズが一致したが、なぜ*3をしたらぴったりはまるかは正直わからない。
        local LOCAL_SCALE_FACTOR = 3

        -- 処理部分：iの範囲チェックと単一呼び出しへの集約
        if sizes[i] and sxs[i] and sys[i] then
            local scale = 100.0 * size / 100
            local posX = sizes[i][1] * LOCAL_SCALE_FACTOR + sx + sxs[i]
            local posY = sizes[i][2] + sy + sys[i]

            obj.effect("リサイズ", "拡大率", scale, "X", posX, "Y", posY, "補間なし", 0, "ピクセル数でサイズ指定", 0)
        end
        obj.effect("縁取り","サイズ",frame_size,"ぼかし",5,"縁色",frame_col)
        if #sizes == 1 then
            obj.draw(offset_x[i] + px + px1,0 + py + py,0,1,alpha/100)
        elseif #sizes == 2 then
            if i == 1 then
                obj.draw(offset_x[i] + px + px1,offset_y[i] - (h / 4) + py + py1 - t_ls / 4,0,1,alpha/100)
            else
                obj.draw(offset_x[i] + px + px2,offset_y[i] + h / 4 + py + py2 + t_ls / 4,0,1,alpha/100)
            end
        elseif #sizes == 3 then
            if i == 1 then
                obj.draw(offset_x[i] + px + px1,offset_y[i] * (i+1) - (h / 3) + py + py1 - t_ls / 3,0,1,alpha/100)
            elseif i == 2 then
                obj.draw(offset_x[i] + px + px2,offset_y[i] * (i) + py + py2,0,1,alpha/100)
            elseif i == 3 then
                obj.draw(offset_x[i] + px + px3,offset_y[i] * (i-1) + h / 3 + py + py3 + t_ls / 3,0,1,alpha/100)
            end
        elseif #sizes == 4 then
            if i == 1 then
                obj.draw(offset_x[i] + px + px1,offset_y[i] * (i+2) - (h / 2.7) + py + py1 - t_ls / 2.5,0,1,alpha/100)
            elseif i == 2 then
                obj.draw(offset_x[i] + px + px2,offset_y[i] * (i+1) - (h / 8) + py + py2 - t_ls / 8,0,1,alpha/100)
            elseif i == 3 then
                obj.draw(offset_x[i] + px + px3,offset_y[i] * (i) + h / 8 + py + py3 + t_ls / 8,0,1,alpha/100)
            elseif i == 4 then
                obj.draw(offset_x[i] + px + px4,offset_y[i] * (i-1) + h / 2.7 + py + py4 + t_ls / 2.5,0,1,alpha/100)
            end
        elseif #sizes == 5 then
            if i == 1 then
                obj.draw(offset_x[i] + px + px1,offset_y[i] * (i+3) -(h / 2.5) + py + py1 - t_ls / 2.5,0,1,alpha/100)
            elseif i == 2 then
                obj.draw(offset_x[i] + px + px2,offset_y[i] * (i+2) - (h / 5.5) + py + py2 - t_ls / 3,0,1,alpha/100)
            elseif i == 3 then
                obj.draw(offset_x[i] + px + px3,offset_y[i] * (i+1) + py + py3,0,1,alpha/100)
            elseif i == 4 then
                obj.draw(offset_x[i] + px + px4,offset_y[i] * (i) + h / 5.5 + py + py4 + t_ls / 3,0,1,alpha/100)
            elseif i == 5 then
                obj.draw(offset_x[i] + px + px5,offset_y[i] * (i-1) + h / 2.5 + py + py5 + t_ls / 2.5,0,1,alpha/100)
            end
        elseif #sizes == 6 then
            if i == 1 then
                obj.draw(offset_x[i] + px + px1,offset_y[i] * (i+3.8) - (h / 2.5) + py + py1 - t_ls / 1.7,0,1,alpha/100)
            elseif i == 2 then
                obj.draw(offset_x[i] + px + px2,offset_y[i] * (i+3) - (h / 4) + py + py2 - t_ls / 4,0,1,alpha/100)
            elseif i == 3 then
                obj.draw(offset_x[i] + px + px3,offset_y[i] * (i+2) - (h / 12.5) + py + py3 - t_ls / 8,0,1,alpha/100)
            elseif i == 4 then
                obj.draw(offset_x[i] + px + px4,offset_y[i] * (i+5) + h / 12.5 + py + py4 + t_ls / 8,0,1,alpha/100)
            elseif i == 5 then
                obj.draw(offset_x[i] + px + px5,offset_y[i] * (i) + h / 4 + py + py5 + t_ls / 4,0,1,alpha/100)
            elseif i == 6 then
                obj.draw(offset_x[i] + px + px6,offset_y[i] * (i-5) + h / 2.5 + py + py6 + t_ls / 1.7,0,1,alpha/100)
            end
        elseif #sizes == 7 then
            if i == 1 then
                obj.draw(offset_x[i] + px + px1,offset_y[i] * (i+5) - (h / 2.3) + py + py1 - t_ls / 3,0,1,alpha/100)
            elseif i == 2 then
                obj.draw(offset_x[i] + px + px2,offset_y[i] * (i+4) - (h / 3.5) + py + py2 - t_ls / 2,0,1,alpha/100)
            elseif i == 3 then
                obj.draw(offset_x[i] + px + px3,offset_y[i] * (i+3) - (h / 6.5) + py + py3 - t_ls / 15,0,1,alpha/100)
            elseif i == 4 then
                obj.draw(offset_x[i] + px + px4,offset_y[i] * (i+2) + py + py4,0,1,alpha/100)
            elseif i == 5 then
                obj.draw(offset_x[i] + px + px5,offset_y[i] * (i+1.2) + h / 6.5 + py + py5 + t_ls / 15,0,1,alpha/100)
            elseif i == 6 then
                obj.draw(offset_x[i] + px + px6,offset_y[i] * (i) + h / 3.5 + py + py6 + t_ls / 2,0,1,alpha/100)
            elseif i == 7 then
                obj.draw(offset_x[i] + px + px7,offset_y[i] * (i-0.9) + h / 2.3 + py + py7 + t_ls / 3,0,1,alpha/100)
            end
        elseif #sizes == 8 then
            if i == 1 then
                obj.draw(offset_x[i] + px + px1,offset_y[i] * (i+6) - (h / 2.3) + py + py1 - t_ls / 2,0,1,alpha/100)
            elseif i == 2 then
                obj.draw(offset_x[i] + px + px2,offset_y[i] * (i+5) - (h / 3.2) + py + py2 - t_ls / 3,0,1,alpha/100)
            elseif i == 3 then
                obj.draw(offset_x[i] + px + px3,offset_y[i] * (i+4) - (h / 5.2) + py + py3 - t_ls / 7,0,1,alpha/100)
            elseif i == 4 then
                obj.draw(offset_x[i] + px + px4,offset_y[i] * (i+3) - (h / 15.2) + py + py4 - t_ls / 12,0,1,alpha/100)
            elseif i == 5 then
                obj.draw(offset_x[i] + px + px5,offset_y[i] * (i+2) + h / 15.2 + py + py5 + t_ls /100,0,1,alpha/100)
            elseif i ==  6 then
                obj.draw(offset_x[i] + px + px6,offset_y[i] * (i+1) + h / 5.2 + py + py6 + t_ls / 12,0,1,alpha/100)
            elseif i == 7 then
                obj.draw(offset_x[i] + px + px7,offset_y[i] * (i) + h / 3.2 + py + py7 + t_ls / 5,0,1,alpha/100)
            elseif i == 8 then
                obj.draw(offset_x[i] + px + px8,offset_y[i] * (i-1) + h / 2.3 + py + py8 + t_ls / 2,0,1,alpha/100)
            end
        elseif #sizes == 9 then
            if i == 1 then
                obj.draw(offset_x[i] + px + px1,offset_y[i] * (i+7) - (h / 2.25) + py + py1 - t_ls / 2.3,0,1,alpha/100)
            elseif i == 2 then
                obj.draw(offset_x[i] + px + px2,offset_y[i] * (i+6) - (h / 3) + py + py2 - t_ls / 3,0,1,alpha/100)
            elseif i == 3 then
                obj.draw(offset_x[i] + px + px3,offset_y[i] * (i+5) - (h / 4.4) + py + py3 - t_ls / 5,0,1,alpha/100)
            elseif i == 4 then
                obj.draw(offset_x[i] + px + px4,offset_y[i] * (i+4) - (h / 9) + py + py4 - t_ls / 7,0,1,alpha/100)
            elseif i == 5 then
                obj.draw(offset_x[i] + px + px5,offset_y[i] * (i+3) + py + py5,0,1,alpha/100)
            elseif i == 6 then
                obj.draw(offset_x[i] + px + px6,offset_y[i] * (i+2) + h / 9 + py + py6 + t_ls / 7,0,1,alpha/100)
            elseif i == 7 then
                obj.draw(offset_x[i] + px + px7,offset_y[i] * (i+1) + h / 4.4 + py + py7 + t_ls / 5,0,1,alpha/100)
            elseif i == 8 then
                obj.draw(offset_x[i] + px + px8,offset_y[i] * (i) + h / 3 + py + py8 + t_ls / 3,0,1,alpha/100)
            elseif i == 9 then
                obj.draw(offset_x[i] + px + px9,offset_y[i] * (i-1) + h / 2.25 + py + py9 + t_ls / 2.3,0,1,alpha/100)
            end
        elseif #sizes == 10 then
            if i == 1 then
                obj.draw(offset_x[i] + px + px1,offset_y[i] * (i+8) - (h / 2.25) + py + py1 - t_ls / 2,0,1,alpha/100)
            elseif i == 2 then
                obj.draw(offset_x[i] + px + px2,offset_y[i] * (i+7) - (h / 2.9) + py + py2 - t_ls / 2,0,1,alpha/100)
            elseif i == 3 then
                obj.draw(offset_x[i] + px + px3,offset_y[i] * (i+6) - (h / 4) + py + py3 - t_ls / 3,0,1,alpha/100)
            elseif i == 4 then
                obj.draw(offset_x[i] + px + px4,offset_y[i] * (i+5) - (h / 7) + py + py4 - t_ls / 3,0,1,alpha/100)
            elseif i == 5 then
                obj.draw(offset_x[i] + px + px5,offset_y[i] * (i+4) - (h / 20) + py + py5 + t_ls / 20,0,1,alpha/100)
            elseif i == 6 then
                obj.draw(offset_x[i] + px + px6,offset_y[i] * (i+3) + h / 20 + py + py6 + t_ls / 12,0,1,alpha/100)
            elseif i == 7 then
                obj.draw(offset_x[i] + px + px7,offset_y[i] * (i+2) + h / 7 + py + py7 + t_ls / 5,0,1,alpha/100)
            elseif i == 8 then
                obj.draw(offset_x[i] + px + px8,offset_y[i] * (i+1) + h / 4 + py + py8 + t_ls / 5,0,1,alpha/100)
            elseif i == 9 then
                obj.draw(offset_x[i] + px + px9,offset_y[i] * (i) + h / 2.9 + py + py9 + t_ls / 2.5,0,1,alpha/100)
            elseif i == 10 then
                obj.draw(offset_x[i] + px + px10,offset_y[i] * (i-1) + h / 2.25 + py + py10 + t_ls / 2,0,1,alpha/100)
            end
        end
    end
elseif zabuton_type == 1 then -- 全体
    obj.load("figure",shape_name,shape_col,100)
    -- ここはxを*3したらぴったりサイズが一致したが、なぜ*3をしたらぴったりはまるかは正直わからない。
    obj.effect("リサイズ","拡大率",100.000,"X",w + sx,"Y",h + sy,"補間なし",0,"ピクセル数でサイズ指定",0)
    obj.effect("縁取り","サイズ",frame_size,"ぼかし",5,"縁色",frame_col)
    obj.draw(0 + px,0 + py,0,1,alpha/100)
end

-- 元テキストの再描画とバッファ書き戻し
obj.copybuffer("object","cache:org")
if zabuton_type == 0 then
    for i = 1, #sizes do
        obj.draw(0,offset_y[i] * (lb-1))
    end
elseif zabuton_type == 1 then
    obj.draw()
end

obj.setoption("drawtarget","framebuffer")
obj.load("tempbuffer")

-- 文字ごとに個別オブジェクトだった場合、座標を復元
if is_multi then
    obj.ox,obj.oy,obj.oz,obj.cx,obj.cy,obj.cz = ox,oy,oz,cx,cy,cz
end